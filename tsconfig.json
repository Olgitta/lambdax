{
  "compilerOptions": {
    "target": "ES2020",             // Match AWS Lambda's Node.js 20 runtime
    "module": "CommonJS",           // AWS Lambda requires CommonJS for Node.js
    "moduleResolution": "Node",      // Proper module resolution
    "lib": ["ES2020"],              // Standard ES2020 features
    "outDir": "dist",               // Output folder for compiled JS
    "rootDir": "src",               // Source folder for TypeScript
    "strict": true,                 // Enable strict type checking
    "esModuleInterop": true,        // Allow interoperability with CommonJS modules
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,           // Skip type checks on `.d.ts` files for faster builds
    "resolveJsonModule": true,      // Enable JSON file imports
    "sourceMap": true,              // Useful for debugging
    "declaration": true,            // Generate `.d.ts` files for type safety
    "noImplicitAny": true,          // Disallow implicit `any`
    "noUnusedLocals": true,         // Remove unused variables
    "noUnusedParameters": true,     // Remove unused function parameters
    "noImplicitReturns": true,      // Ensure all functions return a value
    "noFallthroughCasesInSwitch": true // Prevent unintended switch fallthroughs
  },
  "include": ["src/**/*.ts"],       // Include TypeScript files
  "exclude": ["node_modules", "dist"] // Exclude compiled files and dependencies
}
